# EXPLAIN assertions: each line after ---- must appear in the plan text; lines starting with ! must not.

statement ok
CREATE TABLE emp (id INTEGER PRIMARY KEY, name VARCHAR(20), dept INTEGER, salary INTEGER);

statement ok
CREATE TABLE dept (id INTEGER PRIMARY KEY, name VARCHAR(20));

statement ok
INSERT INTO emp VALUES (1, 'a', 1, 10), (2, 'b', 1, 20), (3, 'c', 2, 30), (4, 'd', 2, 40), (5, 'e', 3, 50);

statement ok
INSERT INTO dept VALUES (1, 'x'), (2, 'y'), (3, 'z');

# equality on the indexed column -> point lookup
plan
SELECT * FROM emp WHERE id = 3;
----
IndexScan emp as emp using emp_id_pkey (id = 3)
!SeqScan
!Filter

# literal on the left works too
plan
SELECT * FROM emp WHERE 3 = id;
----
IndexScan emp as emp using emp_id_pkey (id = 3)

# range scan on the index
plan
SELECT * FROM emp WHERE id >= 2 AND id < 5;
----
IndexScan emp as emp using emp_id_pkey (id >= 2 AND id < 5)
!SeqScan

# the index takes what it can; the rest stays as a filter
plan
SELECT * FROM emp WHERE id > 2 AND salary > 30;
----
IndexScan emp as emp using emp_id_pkey (id > 2)
Filter (emp.salary > 30)

# no index on salary -> sequential scan
plan
SELECT * FROM emp WHERE salary > 30;
----
SeqScan emp
Filter (emp.salary > 30)
!IndexScan

# projection pushdown: only the needed column leaves the scan
plan
SELECT name FROM emp;
----
SeqScan emp as emp [name]

plan
SELECT COUNT(*) FROM emp;
----
Aggregation
SeqScan emp as emp [id]

# equi-join -> hash join; predicate on one side pushed below the join
plan
SELECT e.name, d.name FROM emp e JOIN dept d ON e.dept = d.id WHERE e.salary > 25;
----
HashJoin on
Filter (e.salary > 25)
!NestedLoopJoin

# non-equi join -> nested loop
plan
SELECT e.name FROM emp e JOIN dept d ON e.salary > d.id;
----
NestedLoopJoin on
!HashJoin

# WHERE conjunct spanning both sides becomes the join condition (comma join)
plan
SELECT e.name FROM emp e, dept d WHERE e.dept = d.id;
----
HashJoin on
!(cross)

# aggregation placement
plan
SELECT dept, COUNT(*) FROM emp GROUP BY dept HAVING COUNT(*) > 1 ORDER BY dept LIMIT 5;
----
Limit 5
Projection
Sort by
Filter (COUNT(*) > 1)
Aggregation group by [emp.dept] compute [COUNT(*)]
