statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, v INTEGER, s VARCHAR(10));

statement ok
CREATE TABLE u (id INTEGER, v INTEGER);

statement ok
INSERT INTO t VALUES (1, 10, 'a'), (2, 20, 'b');

statement ok
INSERT INTO u VALUES (1, 100);

statement error no such table
SELECT * FROM missing;

statement error unknown column
SELECT nope FROM t;

statement error unknown column
SELECT t.nope FROM t;

statement error ambiguous
SELECT id FROM t, u;

statement error duplicate table alias
SELECT * FROM t JOIN t ON t.id = t.id;

statement error expected
SELECT FROM t;

statement error expected
SELEC * FROM t;

statement error unterminated string
SELECT * FROM t WHERE s = 'abc;

statement error unexpected
SELECT * FROM t WHERE v = 1 garbage;

statement error expected an integer after LIMIT
SELECT * FROM t LIMIT x;

statement error aggregates are not allowed in WHERE
SELECT * FROM t WHERE COUNT(*) > 1;

statement error must appear in the GROUP BY clause
SELECT id, COUNT(*) FROM t;

statement error must appear in the GROUP BY clause
SELECT s, v FROM t GROUP BY s;

statement error numeric
SELECT SUM(s) FROM t;

statement error duplicate key
INSERT INTO t VALUES (1, 99, 'dup');

statement error type mismatch
INSERT INTO t VALUES (3, 'notanumber', 'x');

statement error out of range
INSERT INTO t VALUES (3000000000, 1, 'x');

statement error values but
INSERT INTO t VALUES (3, 1);

statement error no such column
INSERT INTO t (id, nope) VALUES (3, 1);

statement error constant
INSERT INTO t VALUES (3, v, 'x');

statement error division by zero
SELECT v / 0 FROM t;

statement error table already exists
CREATE TABLE t (a INTEGER);

statement error PRIMARY KEY
CREATE TABLE bad (name VARCHAR PRIMARY KEY);

statement error duplicate column
CREATE TABLE dup (a INTEGER, a INTEGER);

statement error no such table
DROP TABLE nothere;

statement error ORDER BY position
SELECT v FROM t ORDER BY 3;

# failed statements must not have changed anything
query
SELECT id, v, s FROM t ORDER BY id;
----
1|10|a
2|20|b

# a unique-key violation in the middle of a multi-row insert rolls back the whole statement
statement error duplicate key
INSERT INTO t VALUES (10, 1, 'x'), (11, 2, 'y'), (10, 3, 'z');

query
SELECT COUNT(*) FROM t;
----
2
