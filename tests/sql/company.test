# Multi-table schema with hand-computed expected results.
#   departments: 1 Engineering, 2 Sales, 3 HR, 4 Legal (no employees)
#   employees:   7 rows; grace has no department; several have no manager
#   projects:    apollo+beacon (Engineering), cold (Sales)

statement ok
CREATE TABLE departments (id INTEGER PRIMARY KEY, name VARCHAR(30), budget DOUBLE);

statement ok
CREATE TABLE employees (id INTEGER PRIMARY KEY, name VARCHAR(30), dept_id INTEGER, salary INTEGER, manager_id INTEGER);

statement ok
CREATE TABLE projects (id INTEGER PRIMARY KEY, name VARCHAR(30), dept_id INTEGER);

statement ok
INSERT INTO departments VALUES (1, 'Engineering', 500000.0), (2, 'Sales', 300000.0), (3, 'HR', 100000.0), (4, 'Legal', 50000.0);

statement ok
INSERT INTO employees VALUES
  (1, 'alice', 1, 120, NULL),
  (2, 'bob',   1, 100, 1),
  (3, 'carol', 1, 110, 1),
  (4, 'dave',  2, 80,  NULL),
  (5, 'erin',  2, 90,  4),
  (6, 'frank', 3, 70,  NULL),
  (7, 'grace', NULL, 60, NULL);

statement ok
INSERT INTO projects VALUES (1, 'apollo', 1), (2, 'beacon', 1), (3, 'cold', 2);

# ---- selection, ordering, limit
query
SELECT name FROM employees WHERE salary > 90 ORDER BY name;
----
alice
bob
carol

query
SELECT name FROM employees ORDER BY salary DESC LIMIT 3;
----
alice
carol
bob

query
SELECT name AS n, salary FROM employees ORDER BY 2 DESC LIMIT 1;
----
alice|120

query
SELECT id, name FROM employees WHERE id = 5;
----
5|erin

query
SELECT name FROM employees WHERE salary BETWEEN 80 AND 100 AND dept_id IN (1, 2) ORDER BY name;
----
bob
dave
erin

query
SELECT name FROM employees WHERE NOT (salary > 70) ORDER BY name;
----
frank
grace

query
SELECT name, salary * 2 + 1 FROM employees WHERE id = 2;
----
bob|201

query
SELECT budget / 2 FROM departments WHERE id = 3;
----
50000

# ---- NULL semantics
query
SELECT name FROM employees WHERE manager_id IS NULL ORDER BY id;
----
alice
dave
frank
grace

query
SELECT name FROM employees WHERE manager_id = NULL;
----

query
SELECT name FROM employees WHERE manager_id IS NOT NULL ORDER BY id;
----
bob
carol
erin

# ---- joins
query
SELECT e.name, d.name FROM employees e JOIN departments d ON e.dept_id = d.id ORDER BY e.id;
----
alice|Engineering
bob|Engineering
carol|Engineering
dave|Sales
erin|Sales
frank|HR

query
SELECT e.name, m.name FROM employees e JOIN employees m ON e.manager_id = m.id ORDER BY e.id;
----
bob|alice
carol|alice
erin|dave

query
SELECT e.name, p.name FROM employees e, departments d, projects p WHERE e.dept_id = d.id AND p.dept_id = d.id AND d.name = 'Sales' ORDER BY e.name, p.name;
----
dave|cold
erin|cold

query
SELECT d.name, p.name FROM departments d JOIN projects p ON p.dept_id = d.id ORDER BY p.id;
----
Engineering|apollo
Engineering|beacon
Sales|cold

query rowsort
SELECT d.name, e.name FROM departments d JOIN employees e ON e.dept_id = d.id WHERE e.salary >= 100;
----
Engineering|alice
Engineering|bob
Engineering|carol

query
SELECT e.name, d.name FROM employees e JOIN departments d ON e.salary > d.budget / 5000 AND e.dept_id = d.id ORDER BY e.id;
----
alice|Engineering
carol|Engineering
dave|Sales
erin|Sales
frank|HR

# non-equi join (nested loop): pairs of employees where the first earns strictly more, restricted to alice
query
SELECT a.name, b.name FROM employees a JOIN employees b ON a.salary > b.salary WHERE a.id = 5 ORDER BY b.name;
----
erin|dave
erin|frank
erin|grace

# ---- aggregation
query
SELECT COUNT(*), MIN(salary), MAX(salary) FROM employees;
----
7|60|120

query
SELECT COUNT(*), SUM(salary) FROM employees WHERE salary > 1000;
----
0|NULL

query
SELECT COUNT(manager_id), COUNT(*) FROM employees;
----
3|7

query
SELECT d.name, COUNT(*), SUM(e.salary), AVG(e.salary) FROM employees e JOIN departments d ON e.dept_id = d.id GROUP BY d.name ORDER BY d.name;
----
Engineering|3|330|110
HR|1|70|70
Sales|2|170|85

query
SELECT dept_id, COUNT(*) FROM employees GROUP BY dept_id HAVING COUNT(*) > 1 ORDER BY dept_id;
----
1|3
2|2

query
SELECT dept_id, SUM(salary) AS total FROM employees WHERE dept_id IS NOT NULL GROUP BY dept_id ORDER BY total DESC;
----
1|330
2|170
3|70

query
SELECT d.name, COUNT(e.id) FROM departments d JOIN employees e ON e.dept_id = d.id GROUP BY d.name HAVING SUM(e.salary) > 100 ORDER BY 2 DESC, 1;
----
Engineering|3
Sales|2

query
SELECT AVG(salary) FROM employees;
----
90

query
SELECT MAX(salary) - MIN(salary) FROM employees;
----
60

# ---- data modification
statement ok
UPDATE employees SET salary = salary + 10 WHERE dept_id = 3;

query
SELECT salary FROM employees WHERE id = 6;
----
80

statement ok
UPDATE employees SET name = 'franklin the long-named', dept_id = 1 WHERE id = 6;

query
SELECT e.name, d.name FROM employees e JOIN departments d ON e.dept_id = d.id WHERE e.id = 6;
----
franklin the long-named|Engineering

statement ok
DELETE FROM employees WHERE salary < 65;

query
SELECT COUNT(*) FROM employees;
----
6

statement ok
DELETE FROM employees;

query
SELECT COUNT(*) FROM employees;
----
0
